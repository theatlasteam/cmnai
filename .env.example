# Server secret used for sessions, API-key hashing and captcha signatures.
# Generate one with: openssl rand -base64 32
CMNAI_SECRET=change-me

# Seeded admin account (created on first run against an empty database)
CMNAI_ADMIN_EMAIL=admin@cmnai.dev
CMNAI_ADMIN_PASSWORD=cmnai-admin-2026

# Fair-use limits
CMNAI_RATE_LIMIT_PER_MINUTE=60
CMNAI_DAILY_TOKEN_LIMIT=200000
# Accounts with a verified key on an approved provider receive the contributor budget.
CMNAI_CONTRIBUTOR_DAILY_TOKEN_LIMIT=2000000

# Google OAuth (Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID, type "Web application).
# Authorized redirect URI: <your origin>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
